{
  "dsl_version": "2.0.0",
  "name": "Golden cross with an opposite-signal exit",
  "description": "Slow trend following that leaves on the mirror of its own entry. Exercises: opposite_signal, trailing percent_stop, fixed_fraction sizing, next_open fills.",
  "source_text": "Go long when the 50-day average crosses above the 200-day average, and exit when it crosses back below. Trail a 15% stop.",
  "universe": {
    "symbols": ["SPY", "QQQ", "IWM", "DIA", "XLE", "XLF", "XLK", "XLV"]
  },
  "direction": "long",
  "entry": {
    "logic": "all",
    "conditions": [
      {
        "left": {"kind": "indicator", "name": "sma", "period": 50},
        "op": "crosses_above",
        "right": {"kind": "indicator", "name": "sma", "period": 200}
      }
    ]
  },
  "exits": [
    {"kind": "opposite_signal"},
    {"kind": "percent_stop", "percent": 15, "trail": true}
  ],
  "sizing": {
    "method": "fixed_fraction",
    "max_open_positions": 5,
    "fraction": 0.2
  },
  "execution": {
    "signal_timing": "close",
    "fill_timing": "next_open",
    "intrabar_priority": "stop_first",
    "gap_policy": "fill_at_open",
    "candidate_priority": "alphabetical"
  },
  "costs": {
    "commission_bps": 1,
    "slippage_model": "fixed_bps",
    "slippage_bps": 5
  }
}
